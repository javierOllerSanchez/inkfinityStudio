---
import { withBase } from '../base';
import '../../design/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCopy } from '../copy';

interface Props {
  title?: string;
  description?: string;
  // Página con versión en los dos idiomas: da los enlaces hreflang y el del selector de idioma
  page?: 'home' | 'privacy';
}

const { site } = getCopy(Astro.currentLocale);
const { title, description = site.description, page } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const alternates = page
  ? (['es', 'en'] as const).map((l) => ({ lang: l, href: new URL(withBase(getCopy(l).paths[page]), Astro.site).href }))
  : [];
const other = alternates.find((a) => a.lang !== site.lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('/og.png'), Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <meta name="theme-color" content="#15123A" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/assets/icons/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/assets/icons/apple-touch-icon-180.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!-- Las dos fuentes de la primera pantalla; Caveat se pide cuando hace falta -->
    <link rel="preload" href={withBase('/fonts/bricolage-grotesque-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/fonts/dm-sans-latin.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Inkfinity Software" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skip}</a>
    <Header altHref={other && new URL(other.href).pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/fx';</script>
  </body>
</html>
