---
import { getCollection } from 'astro:content';
import AppStrip from './AppStrip.astro';
import AsciiReveal from './AsciiReveal.astro';
import { apps, site } from '../copy';

const entries = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---

<!-- Una franja por app; a la izquierda, un raíl fijo con el título -->
<section id="apps" class="board apps" aria-labelledby="apps-title">
  <div class="tile rail">
    <div class="rail-inner" data-reveal>
      <h2 id="apps-title">{apps.title}</h2>
      <p>{apps.lead}</p>
      <ul class="stores">
        <li><a href={site.playDeveloperUrl}>{apps.stores.play} <span aria-hidden="true">→</span></a></li>
        <li><a href={site.appStoreDeveloperUrl}>{apps.stores.appStore} <span aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </div>

  <ul class="strips">
    {entries.map((e, i) => <AppStrip app={e.data} index={i} />)}
    <li class="tile next" data-reveal style={`--i:${entries.length + 1}`}>
      <AsciiReveal design="tinta" />
      <img src="/assets/mascot/borron-mmm.svg" alt="" width="480" height="480" loading="lazy" />
      <p>{apps.next}</p>
    </li>
  </ul>
</section>

<style>
  .rail { background: var(--lavender-50); color: var(--accent-ink); }
  .rail-inner { display: grid; gap: var(--space-4); justify-items: start; }
  h2 { font-size: clamp(2.5rem, 9vw, 3rem); line-height: 0.95; text-wrap: balance; }
  .rail p { font-size: var(--fs-body-lg); }
  .stores { margin: 0; padding: 0; list-style: none; }
  .stores a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--violet-600);
    font-weight: 700;
  }

  .strips { display: grid; gap: var(--board-gap); margin: 0; padding: 0; list-style: none; }

  .next {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    background: var(--ink-900);
    color: var(--white);
  }
  .next img { width: 96px; flex: none; }
  .next p {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-variation-settings: "wdth" 75;
    letter-spacing: var(--display-tracking);
    font-size: var(--fs-h3);
    line-height: 1.05;
  }

  /* Escritorio: raíl de 3 columnas; su contenido se queda fijo mientras pasan las franjas */
  @media (min-width: 1024px) {
    .apps { grid-template-columns: repeat(12, 1fr); }
    .rail { grid-column: 1 / 4; padding: var(--space-6); }
    .rail-inner { position: sticky; top: calc(56px + 2 * var(--board-gap) + var(--space-6)); }
    h2 { font-size: clamp(2.5rem, 3.2vw, 3.25rem); }
    .strips { grid-column: 4 / -1; }
    .next { padding: var(--space-5) var(--space-6); }
    .next img { width: 128px; }
    .next p { font-size: var(--fs-h2); }
  }
</style>
