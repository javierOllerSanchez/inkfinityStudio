---
import { withBase } from '../base';
import { getCopy } from '../copy';

import type { Copy } from '../copy';
const { crew } = getCopy(Astro.currentLocale);
interface Props { member: Copy['crew']['members'][number]; index: number }
const { member, index } = Astro.props;
// Tintes en orden fijo. Sin lima: es solo un chispazo y ya está en el hero.
const tones = ['coral', 'violet', 'lavender', 'paper'];

// Logotipos oficiales de cada red (Simple Icons, CC0), sin modificar
const icons = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
};
---

<li class={`tile member tone--${tones[index % tones.length]}`} data-reveal style={`--i:${index + 1}`}>
  <div class="portrait">
    {member.avatar
      ? <img class:list={[{ illustration: member.avatar.endsWith('.svg') }]} src={withBase(member.avatar)} alt={`${crew.portraitAlt} ${member.name}`} width="400" height="500" loading="lazy" />
      : <span class="placeholder">{crew.avatarPlaceholder}</span>}
  </div>
  <h3>{member.name}</h3>
  <p>{member.role}</p>
  {member.links && (
    <ul class="social">
      {member.links.map((l) => (
        <li>
          <a href={l.href} rel="me" aria-label={crew.networkLabel(crew.networks[l.network], member.name)}>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={icons[l.network]} /></svg>
          </a>
        </li>
      ))}
    </ul>
  )}
</li>

<style>
  .member {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-width: 0;
    padding: 0 0 var(--space-4);
    color: var(--accent-ink);
  }
  .tone--coral { background: var(--coral-500); }
  .tone--violet { background: var(--violet-300); }
  .tone--lavender { background: var(--lavender-50); }
  .tone--paper { background: var(--texture-riso), var(--paper-100); }

  /* Retrato 4:5 a sangre. Las fotos se tratan igual para que parezcan un mismo juego: grises fundidos con el tinte. */
  .portrait {
    align-self: stretch;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }
  /* Las ilustraciones ya van en la paleta y sobre fondo transparente: sin el tratamiento de foto */
  .portrait img.illustration { filter: none; mix-blend-mode: normal; object-position: bottom; }
  .placeholder { padding: var(--space-4); font-size: var(--fs-small); font-weight: 700; text-align: center; }

  h3, p, .social { margin-inline: var(--space-4); }
  h3 { font-size: var(--fs-h3); overflow-wrap: anywhere; }
  p { font-size: var(--fs-small); overflow-wrap: anywhere; }
  /* Iconos de redes: objetivo táctil de 44 px, el icono a 22 */
  .social { display: flex; gap: var(--space-1); margin-top: var(--space-2); padding: 0; list-style: none; }
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: -11px;
    border-radius: var(--radius-sm);
    color: var(--accent-ink);
  }
  .social li + li a { margin-left: 0; }
  .social svg { fill: currentColor; }
  .social a:focus-visible { outline-color: var(--accent-ink); outline-offset: 0; }
  @media (hover: hover) and (pointer: fine) {
    .social a:hover svg { translate: 0 -2px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .social svg { transition: translate 160ms var(--ease-out); }
    .social a:active { scale: 0.94; }
    .social a { transition: scale 120ms var(--ease-out); }
  }

  @media (min-width: 1024px) {
    h3, p, .social { margin-inline: var(--space-5); }
    .member { padding-bottom: var(--space-5); }
  }
</style>
