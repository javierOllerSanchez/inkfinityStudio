---
import { crew } from '../copy';

interface Props { member: (typeof crew.members)[number]; index: number }
const { member, index } = Astro.props;
// Tintes en orden fijo. Sin lima: es solo un chispazo y ya está en el hero.
const tones = ['coral', 'violet', 'lavender', 'paper'];
---

<li class={`tile member tone--${tones[index % tones.length]}`} data-reveal style={`--i:${index + 1}`}>
  <div class="portrait">
    {member.avatar
      ? <img src={member.avatar} alt={member.name} width="400" height="500" loading="lazy" />
      : <span class="placeholder">{crew.avatarPlaceholder}</span>}
  </div>
  <h3>{member.name}</h3>
  <p>{member.role}</p>
  {member.link && <a href={member.link.href}>{member.link.label}<span class="visually-hidden"> de {member.name}</span></a>}
</li>

<style>
  .member {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-width: 0;
    padding: 0 0 var(--space-4);
    color: var(--accent-ink);
  }
  .tone--coral { background: var(--coral-500); }
  .tone--violet { background: var(--violet-300); }
  .tone--lavender { background: var(--lavender-50); }
  .tone--paper { background: var(--texture-riso), var(--paper-100); }

  /* Retrato 4:5 a sangre. Las fotos se tratan igual para que parezcan un mismo juego: grises fundidos con el tinte. */
  .portrait {
    align-self: stretch;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    mix-blend-mode: multiply;
  }
  .placeholder { padding: var(--space-4); font-size: var(--fs-small); font-weight: 700; text-align: center; }

  h3, p, a { margin-inline: var(--space-4); }
  h3 { font-size: var(--fs-h3); overflow-wrap: anywhere; }
  p { font-size: var(--fs-small); overflow-wrap: anywhere; }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-ink);
    font-weight: 700;
  }
  a:focus-visible { outline-color: var(--accent-ink); }

  @media (min-width: 1024px) {
    h3, p, a { margin-inline: var(--space-5); }
    .member { padding-bottom: var(--space-5); }
  }
</style>
