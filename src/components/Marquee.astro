---
import { marquee } from '../copy';

const drop = 'M5 0 C7 3.2 10 6.4 10 9 A5 5 0 0 1 0 9 C0 6.4 3 3.2 5 0 Z';
---

<!-- Decorativa: el mismo texto ya está en la página -->
<div class="marquee" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => (
      <ul>
        {marquee.map((t) => (
          <li>{t}<svg viewBox="0 0 10 14"><path d={drop} /></svg></li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 1;
    margin-block: calc(-1 * var(--space-5));
    padding-block: var(--space-4);
    background: var(--violet-600);
    color: var(--white);
    rotate: -2deg;
    width: 110%;
    margin-inline: -5%;
    overflow: hidden;
    box-shadow: 0 6px 0 var(--ink-950);
  }
  .track { display: flex; width: max-content; }
  ul { display: flex; margin: 0; padding: 0; list-style: none; }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-right: var(--space-5);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-variation-settings: "wdth" 75;
    letter-spacing: var(--display-tracking);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    text-transform: uppercase;
    white-space: nowrap;
  }
  svg { width: 0.5em; fill: var(--lime-400); }

  @media (prefers-reduced-motion: no-preference) {
    .track { animation: slide 28s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
  }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
