---
import TeamMember from './TeamMember.astro';
import { crew } from '../copy';
---

<div class="strip" aria-hidden="true"></div>
<section id="crew" class="section theme-ink" aria-labelledby="crew-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{crew.eyebrow}</p>
      <h2 id="crew-title">{crew.title}</h2>
      <p>{crew.lead}</p>
    </div>
    <ul class="grid">
      {crew.members.map((m, i) => <TeamMember member={m} index={i} />)}
    </ul>
  </div>
</section>

<style>
  /* Único uso del patrón: franja fina entre apps y crew */
  .strip { height: 24px; background: url('/assets/patterns/pattern-tile-180.svg') center / 90px repeat-x; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 360px) and (max-width: 479px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  }
</style>
