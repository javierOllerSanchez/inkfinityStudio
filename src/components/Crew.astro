---
import TeamMember from './TeamMember.astro';
import { crew } from '../copy';

// Hasta 4 por fila en escritorio; con menos miembros no quedan huecos vacíos
const cols = Math.min(4, crew.members.length);
---

<!-- Titular a la izquierda; cada miembro es una baldosa de color con su retrato -->
<section id="crew" class="board crew" aria-labelledby="crew-title">
  <div class="tile head" data-reveal>
    <h2 id="crew-title">{crew.title}</h2>
    <p>{crew.lead}</p>
  </div>
  <ul class="members" style={`--cols:${cols}`}>
    {crew.members.map((m, i) => <TeamMember member={m} index={i} />)}
  </ul>
</section>

<style>
  .head {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-4);
    padding-top: var(--space-8);
    /* Violeta: la baldosa anterior (la app «en el tintero») ya es tinta */
    background: var(--violet-600);
    color: var(--white);
  }
  h2 { font-size: clamp(2.75rem, 11vw, 4.5rem); line-height: 0.92; text-wrap: balance; }
  .head p { font-size: var(--fs-body-lg); max-width: 26ch; }

  .members {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--board-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .members { grid-template-columns: repeat(var(--cols), 1fr); }
  }
  @media (min-width: 1024px) {
    .crew { grid-template-columns: repeat(12, 1fr); }
    .head { grid-column: 1 / 5; padding: var(--space-6); }
    h2 { font-size: clamp(2.75rem, 4.6vw, 4.5rem); }
    .members { grid-column: 5 / -1; }
  }
</style>
