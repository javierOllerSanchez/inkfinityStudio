---
import { hero } from '../copy';
import borronRaw from '../../public/assets/mascot/borron-chulo-saludando.svg?raw';

// SVG en línea para poder balancear el tentáculo levantado sin tocar el dibujo.
const borron = borronRaw.replace('<path d="M160 138', '<path class="wave" d="M160 138');
const drop = 'M5 0 C7 3.2 10 6.4 10 9 A5 5 0 0 1 0 9 C0 6.4 3 3.2 5 0 Z';
const words = hero.title.split(' ');
---

<section class="hero section theme-ink" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <h1 id="hero-title">
        {words.map((w, i) => <><span class="word" style={`--i:${i}`}>{w}</span>{' '}</>)}
      </h1>
      <p class="lead enter" style="--i:5">{hero.lead}</p>
      <div class="actions enter" style="--i:6">
        <a class="btn btn--coral" href="#apps">{hero.cta}</a>
        <a class="link-arrow" href="#crew">{hero.secondary} <span class="arrow" aria-hidden="true">&nbsp;→</span></a>
      </div>
    </div>

    <!-- Escena por capas: el JS la gira hacia el puntero y cada capa está a una profundidad distinta -->
    <div class="art">
      <svg class="halo" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" /></svg>
      <svg class="drop drop--lime" viewBox="0 0 10 14" aria-hidden="true"><path d={drop} /></svg>
      <svg class="drop drop--violet" viewBox="0 0 10 14" aria-hidden="true"><path d={drop} /></svg>
      <svg class="drop drop--lime-sm" viewBox="0 0 10 14" aria-hidden="true"><path d={drop} /></svg>
      <div class="borron" set:html={borron} />
      <p class="note" aria-hidden="true">{hero.note}</p>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: var(--space-7); overflow: hidden; }
  .grid { display: grid; gap: var(--space-7); align-items: center; }

  h1 {
    font-size: var(--fs-hero);
    line-height: 0.95;
    max-width: 11ch;
    /* Relieve 3D con sombra dura escalonada */
    text-shadow:
      1px 1px 0 var(--violet-600),
      2px 2px 0 var(--violet-600),
      3px 3px 0 var(--violet-600),
      4px 4px 0 var(--violet-600),
      5px 5px 0 var(--violet-600),
      6px 6px 0 var(--violet-600);
  }
  .word { display: inline-block; }
  .lead { margin-top: var(--space-5); color: var(--text-muted); font-size: var(--fs-body-lg); max-width: 34rem; }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-6);
  }
  .arrow { display: inline-block; transition: translate var(--dur-base) var(--ease-out); }
  .link-arrow:hover .arrow { translate: 6px 0; }

  .art {
    position: relative;
    width: min(100%, 420px);
    margin-inline: auto;
    aspect-ratio: 1;
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 600ms var(--ease-out);
  }
  .halo { position: absolute; inset: 6%; width: 88%; fill: var(--ink-800); transform: translateZ(-60px); }
  .borron { position: relative; transform: translateZ(40px); }
  .borron :global(svg) { width: 100%; height: auto; }

  .drop { position: absolute; --z: 110px; transform: translateZ(var(--z)) rotate(var(--r)); }
  .drop--lime { width: 7%; bottom: 20%; left: 2%; fill: var(--lime-400); --r: -14deg; }
  .drop--violet { width: 5%; bottom: 14%; right: 4%; fill: var(--violet-300); --r: 12deg; --z: 150px; }
  .drop--lime-sm { width: 3.5%; top: 4%; right: 22%; fill: var(--lime-400); --r: 0deg; --z: 80px; }

  .note {
    position: absolute;
    top: 2%;
    left: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.5rem, 4vw, 2rem);
    color: var(--lime-400);
    transform: translateZ(90px) rotate(-6deg);
  }

  .borron :global(.wave) { transform-box: view-box; transform-origin: 160px 138px; }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrada sin JS: el titular salta palabra a palabra (sin opacidad, para no retrasar el LCP) */
    .word { animation: word-in 900ms var(--ease-out) both; animation-delay: calc(var(--i) * 80ms); }
    .enter { animation: fade-up 900ms var(--ease-out) both; animation-delay: calc(var(--i) * 80ms); }
    .art { animation: art-in 1200ms 200ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
    .borron :global(.wave) { animation: wave 2.4s ease-in-out infinite alternate; }
    .drop { animation: float 4s ease-in-out infinite alternate; }
    .drop--violet { animation-duration: 5s; animation-delay: -1s; }
    .drop--lime-sm { animation-duration: 3.2s; animation-delay: -2s; }
  }
  @keyframes word-in {
    from { transform: translateY(0.45em) rotate(6deg) scale(0.85); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(24px); }
  }
  @keyframes art-in {
    from { scale: 0.6; rotate: 10deg; opacity: 0; }
  }
  @keyframes wave {
    from { transform: rotate(-6deg); }
    to { transform: rotate(8deg); }
  }
  @keyframes float {
    from { transform: translateZ(var(--z)) rotate(var(--r)) translateY(0); }
    to { transform: translateZ(var(--z)) rotate(calc(var(--r) + 10deg)) translateY(-14px); }
  }

  @media (min-width: 900px) {
    .hero { padding-top: var(--space-8); }
    .grid { grid-template-columns: 1.15fr 1fr; }
    .art { width: 100%; max-width: 480px; }
  }
</style>
