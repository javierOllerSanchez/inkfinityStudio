---
import { hero, site } from '../copy';
import borronRaw from '../../public/assets/mascot/borron-chulo-saludando.svg?raw';

// SVG en línea para poder balancear el tentáculo levantado sin tocar el dibujo.
const borron = borronRaw.replace('<path d="M160 138', '<path class="wave" d="M160 138');
---

<!-- Tablero 2×2: logotipo · Borrón · titular · frase + acción -->
<section class="board hero" aria-labelledby="hero-title">
  <div class="tile name">
    <img src="/assets/logo/inkfinity-wordmark-color.svg" alt={site.name} width="1056" height="400" fetchpriority="high" />
  </div>

  <div class="tile mascot">
    <div class="borron" set:html={borron} />
    <p class="note" aria-hidden="true">{hero.note}</p>
  </div>

  <div class="tile title">
    <h1 id="hero-title">{hero.title}</h1>
  </div>

  <div class="tile lead">
    <p>{hero.lead}</p>
    <a class="btn btn--ink" href="#apps">{hero.cta}</a>
  </div>

  <a class="tile crew" href="#crew">
    <span>{hero.secondary}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20 20 4M8 4h12v12" /></svg>
  </a>
</section>

<style>
  /* La cabecera no tiene hueco inferior: el hero pone el suyo */
  .hero { padding-top: var(--board-gap); }

  /* Logotipo: el SVG oficial a todo el ancho de la baldosa, apoyado abajo a la izquierda */
  .name { display: flex; align-items: flex-end; background: var(--lavender-50); }
  .name img { width: 100%; }
  @media (min-width: 1024px) {
    /* Que el tablero quepa en la primera pantalla: el logotipo no pasa del 34 % de alto */
    .name img { width: min(100%, 34svh * 2.64); }
  }

  /* Borrón muy grande sobre tinta */
  .mascot {
    display: grid;
    place-items: center;
    min-height: 92vw;
    background: var(--ink-900);
  }
  .borron { width: min(100%, 560px); }
  .borron :global(svg) { width: 100%; height: auto; }
  .borron :global(.wave) { transform-box: view-box; transform-origin: 160px 138px; }
  .note {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    color: var(--lime-400);
    rotate: -6deg;
  }

  .title { display: flex; align-items: flex-end; background: var(--violet-600); color: var(--white); }
  h1 {
    font-size: clamp(2.5rem, 9vw, 5.5rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  .lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    background: var(--coral-500);
    color: var(--accent-ink);
  }
  .lead p { font-size: var(--fs-body-lg); line-height: 1.35; max-width: 30ch; }

  /* Baldosa lima: un chispazo, toda ella es el enlace */
  .crew {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 120px;
    background: var(--lime-400);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    font-variation-settings: "wdth" 75;
    letter-spacing: var(--display-tracking);
    font-size: var(--fs-h3);
    line-height: 1;
    text-decoration: none;
  }
  .crew svg {
    align-self: flex-end;
    width: 40px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate var(--dur-base) var(--ease-out);
  }
  .crew:hover svg { translate: 4px -4px; }
  .crew:focus-visible { outline-color: var(--lime-400); }

  /* Móvil: una columna; titular y acción antes que Borrón para que entren en la primera pantalla */
  .name { order: 1; }
  .title { order: 2; }
  .lead { order: 3; }
  .mascot { order: 4; }
  .crew { order: 5; }

  @media (min-width: 600px) {
    .hero { grid-template-columns: 1fr 1fr; }
    .name, .title, .mascot { grid-column: 1 / -1; }
    .mascot { min-height: 70vw; }
    .crew { order: 4; }
    .mascot { order: 5; }
  }

  /* Escritorio: el tablero ocupa la primera pantalla. Izquierda 7 columnas, Borrón 5. */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: auto 1fr auto;
      min-height: calc(100svh - 56px - var(--board-gap));
    }
    .tile { order: 0; }
    h1 { font-size: clamp(2.5rem, 5.6vw, 5.5rem); }
    .name { grid-column: 1 / 8; grid-row: 1; }
    .title { grid-column: 1 / 8; grid-row: 2; }
    .lead { grid-column: 1 / 5; grid-row: 3; }
    .crew { grid-column: 5 / 8; grid-row: 3; }
    .mascot { grid-column: 8 / -1; grid-row: 1 / 4; min-height: 0; }
    /* Borrón asoma desde abajo, algo desbordado: la baldosa recorta los tentáculos */
    .borron { width: 118%; max-width: none; align-self: end; margin-bottom: -14%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Momento fuerte: Borrón se revela con una persiana desde abajo y se asienta */
    .mascot { animation: shutter 1100ms var(--ease-out) both; }
    .borron { animation: settle 1400ms var(--ease-out) both; }
    .borron :global(.wave) { animation: wave 2.4s ease-in-out 1.2s infinite alternate; }
    /* El resto de baldosas sube escalonado. Logotipo y titular solo se desplazan:
       sin opacidad, porque el logotipo es el LCP y el fundido lo retrasaba */
    .lead, .crew { animation: rise 700ms var(--ease-out) both; }
    .name, .title { animation: rise-solid 700ms var(--ease-out) both; }
    .title { animation-delay: 70ms; }
    .lead { animation-delay: 140ms; }
    .crew { animation-delay: 210ms; }
  }
  @keyframes shutter { from { clip-path: inset(100% 0 0 0 round var(--radius-md)); } to { clip-path: inset(0 0 0 0 round var(--radius-md)); } }
  @keyframes settle { from { scale: 1.12; translate: 0 6%; } }
  @keyframes rise { from { opacity: 0; translate: 0 24px; } }
  @keyframes rise-solid { from { translate: 0 24px; } }
  @keyframes wave {
    from { transform: rotate(-6deg); }
    to { transform: rotate(8deg); }
  }
</style>
