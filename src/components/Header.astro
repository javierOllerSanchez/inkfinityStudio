---
import { nav } from '../copy';
---

<!-- Fila de baldosas: símbolo · enlaces · acción. El hueco entre baldosas es el fondo del tablero. -->
<header class="site-header">
  <a href="/" class="tile logo" aria-label={nav.home}>
    <img src="/assets/logo/inkfinity-symbol-on-dark.svg" alt="" width="66" height="45" />
  </a>
  <div class="tile links">
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      {nav.menu}
    </button>
    <nav id="site-nav" aria-label={nav.label}>
      <ul>
        {nav.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <a href="/#apps" class="tile action">{nav.action}</a>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const navEl = document.getElementById('site-nav')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    navEl.classList.toggle('open', open);
  };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  navEl.addEventListener('click', (e) => (e.target as Element).closest('a') && set(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    gap: var(--board-gap);
    padding: var(--board-gap) var(--board-gap) 0;
    background: var(--ink-950);
  }
  .tile {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-radius: var(--radius-md);
    background: var(--ink-900);
    color: var(--white);
  }
  .logo { justify-content: center; width: 72px; flex: none; }
  .logo img { width: 44px; }
  .links { flex: 1; justify-content: flex-end; padding-inline: var(--space-3); }

  ul { display: flex; gap: var(--space-1); margin: 0; padding: 0; list-style: none; }
  nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  nav a:hover { background: var(--ink-800); }
  nav a:focus-visible { outline-color: var(--lime-400); }

  .action {
    flex: none;
    padding-inline: var(--space-5);
    background: var(--coral-500);
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .action:hover { background: var(--coral-600); }
  .action:focus-visible { outline-color: var(--lime-400); }

  .menu-btn { display: none; }

  /* Móvil con JS: el menú se pliega tras un botón. Sin JS, los enlaces siguen visibles. */
  @media (max-width: 767px) {
    .action { display: none; }
    :global(.js) .action { display: flex; }
    nav a { padding: 0 var(--space-2); }

    :global(.js) .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 44px;
      padding: 0 var(--space-3);
      background: transparent;
      color: var(--white);
      border: 0;
      font: 700 var(--fs-body) var(--font-body);
      cursor: pointer;
    }
    .menu-icon, .menu-icon::before, .menu-icon::after {
      display: block;
      width: 16px;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
    }
    .menu-icon { position: relative; }
    .menu-icon::before, .menu-icon::after { content: ""; position: absolute; left: 0; }
    .menu-icon::before { top: -5px; }
    .menu-icon::after { top: 5px; }

    /* El desplegable es otra baldosa bajo la fila */
    :global(.js) nav {
      display: none;
      position: absolute;
      inset: 100% var(--board-gap) auto;
      margin-top: var(--board-gap);
      padding: var(--space-2);
      background: var(--ink-900);
      border-radius: var(--radius-md);
    }
    :global(.js) nav.open { display: block; }
    :global(.js) ul { flex-direction: column; }
    :global(.js) nav a { font-size: var(--fs-body-lg); padding: 0 var(--space-4); }
  }
</style>
