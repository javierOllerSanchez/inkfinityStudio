---
import { howWeWork } from '../copy';
---

<!-- Mosaico de frases: Borrón · titular grande · las tres reglas en letra grande -->
<section class="board how" aria-labelledby="how-title">
  <div class="tile mascot" data-reveal="pop">
    <img src="/assets/mascot/borron-anda.svg" alt="" width="480" height="480" loading="lazy" />
  </div>

  <div class="tile head" data-reveal style="--i:1">
    <h2 id="how-title">{howWeWork.title}</h2>
  </div>

  <ul class="tile rules">
    {howWeWork.rules.map((r, i) => (
      <li data-reveal style={`--i:${i + 1}`}>
        <h3>{r.title}</h3>
        <p>{r.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .mascot {
    display: grid;
    place-items: center;
    min-height: 72vw;
    background: var(--lavender-50);
  }
  .mascot img { width: min(100%, 420px); }

  /* Móvil: el Borrón del hero acaba de pasar; este va al final de la sección */
  .head { order: 1; }
  .rules { order: 2; }
  .mascot { order: 3; min-height: 60vw; }

  .head {
    display: flex;
    align-items: flex-end;
    min-height: 46svh;
    background: var(--coral-500);
    color: var(--accent-ink);
  }
  h2 {
    font-size: clamp(3.5rem, 15vw, 8.25rem);
    line-height: 0.88;
    text-wrap: balance;
  }

  /* Una lista en letra grande, sin iconos: cada regla es una fila */
  .rules {
    display: grid;
    gap: var(--space-7);
    margin: 0;
    padding: var(--space-6) var(--space-5);
    list-style: none;
    background: var(--ink-900);
    color: var(--white);
  }
  .rules li { display: grid; gap: var(--space-3); }
  h3 { font-size: clamp(2.75rem, 7vw, 6rem); line-height: 0.95; }
  .rules p { font-size: var(--fs-body-lg); max-width: 32ch; }

  /* Escritorio: Borrón a la izquierda (el del hero está a la derecha), titular a 8 columnas */
  @media (min-width: 1024px) {
    .how { grid-template-columns: repeat(12, 1fr); }
    .mascot { grid-column: 1 / 5; min-height: 0; order: 0; }
    .head { grid-column: 5 / -1; min-height: 62svh; padding: var(--space-6); order: 0; }
    h2 { font-size: clamp(4rem, 9vw, 9rem); }
    .rules { grid-column: 1 / -1; padding: var(--space-8) var(--space-6); order: 0; }
    .rules li {
      grid-template-columns: 5fr 7fr;
      align-items: baseline;
      gap: var(--space-6);
    }
    .rules p { grid-column: 2; max-width: 36ch; font-size: var(--fs-h3); line-height: 1.3; }
  }
</style>
