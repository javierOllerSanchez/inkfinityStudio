---
import { contact, site } from '../copy';

// Expresión de Borrón para cada estado de la barra (ver tabla de docs/BRAND.md)
const faces = {
  idle: 'borron-chulo',
  ko: 'borron-ko',
  think: 'borron-mmm',
  yay: 'borron-toma-ya',
} as const;
---

<!-- La idea en el tintero: un formulario mailto que funciona sin JS; con JS, Borrón reacciona -->
<section id="contacto" class="board contact" aria-labelledby="contact-title">
  <div class="tile field" data-reveal>
    <h2 id="contact-title">{contact.title}</h2>
    <p class="lead">{contact.text}</p>

    <form class="bar" action={`mailto:${site.email}`} method="get">
      <!-- div y no fieldset: el fieldset no deja que sus hijos llenen la altura de la celda -->
      <div class="cell kind" role="radiogroup" aria-label={contact.kindLabel}>
        {contact.kinds.map((k, i) => (
          <label>
            <input type="radio" name="subject" value={k.value} data-mood={k.mood} checked={i === 0} />
            <span>{k.label}</span>
          </label>
        ))}
      </div>
      <label class="cell text">
        <span class="visually-hidden">{contact.fieldLabel}</span>
        <textarea name="body" rows="2" required placeholder={contact.placeholder}></textarea>
      </label>
      <button class="cell send" type="submit">{contact.submit}</button>
    </form>

    <p class="small">
      {contact.note} {contact.orWrite} <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
    <p class="status" role="status" data-sent={contact.sent}></p>
  </div>

  <div class="tile mascot" data-mood="idle" aria-hidden="true">
    {Object.entries(faces).map(([mood, file]) => (
      <img data-show={mood} src={`/assets/mascot/${file}.svg`} alt="" width="480" height="480" loading="lazy" />
    ))}
    {Object.entries(contact.moods).map(([mood, text]) => <p class="note" data-show={mood}>{text}</p>)}
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact .bar')!;
  const mascot = document.querySelector<HTMLElement>('.contact .mascot')!;
  const status = document.querySelector<HTMLElement>('.contact .status')!;
  const text = form.querySelector('textarea')!;
  let sent = false;

  const kind = () => form.querySelector<HTMLInputElement>('input[name="subject"]:checked')!;
  const mood = () => {
    mascot.dataset.mood = sent ? 'yay' : text.value.trim() ? 'think' : kind().dataset.mood;
  };

  form.addEventListener('input', () => {
    sent = false;
    status.textContent = '';
    mood();
  });

  // Se monta el enlace a mano: el envío nativo codifica los espacios como «+» y algunos correos los muestran tal cual
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = (v: string) => encodeURIComponent(v);
    location.href = `${form.getAttribute('action')}?subject=${q(kind().value)}&body=${q(text.value)}`;
    sent = true;
    status.textContent = status.dataset.sent!;
    mood();
  });
</script>

<style>
  .field {
    display: grid;
    gap: var(--space-5);
    align-content: end;
    padding-block: var(--space-8) var(--space-6);
    background: var(--coral-500);
    color: var(--accent-ink);
  }
  h2 { font-size: clamp(2.5rem, 10vw, 5rem); line-height: 0.92; text-wrap: balance; }
  .lead { font-size: var(--fs-body-lg); max-width: 34ch; }

  /* Barra de tres celdas: tipo · texto · enviar */
  .bar { display: grid; gap: var(--board-gap); }
  .cell { margin: 0; border: 0; border-radius: var(--radius-sm); min-height: 60px; }

  .kind { display: flex; gap: var(--space-1); padding: var(--space-1); background: var(--lavender-50); }
  .kind label { position: relative; flex: 1; display: flex; }
  .kind input { position: absolute; inset: 0; margin: 0; opacity: 0; pointer-events: none; }
  .kind span {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0 var(--space-4);
    border-radius: calc(var(--radius-sm) - 2px);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .kind input:checked + span { background: var(--ink-900); color: var(--white); }
  .kind input:focus-visible + span { outline: 3px solid var(--ink-900); outline-offset: 2px; }

  .text { display: flex; background: var(--lavender-50); transition: background-color var(--dur-fast) var(--ease-out); }
  .text:focus-within { background: var(--white); outline: 3px solid var(--ink-900); outline-offset: 2px; }
  textarea {
    flex: 1;
    min-height: 60px;
    padding: var(--space-4);
    border: 0;
    background: transparent;
    color: var(--accent-ink);
    font: inherit;
    font-size: var(--fs-body-lg);
    resize: vertical;
    outline: none;
  }
  textarea::placeholder { color: var(--tide-600); }

  .send {
    padding: 0 var(--space-5);
    background: var(--ink-900);
    color: var(--white);
    font: 700 var(--fs-body-lg) var(--font-body);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), scale var(--dur-fast) var(--ease-out);
  }
  .send:hover { background: var(--ink-800); }
  .send:active { scale: 0.97; }
  .send:focus-visible { outline-color: var(--ink-900); }

  .small { font-size: var(--fs-small); }
  .small a { color: var(--accent-ink); font-weight: 700; }
  .small a:focus-visible { outline-color: var(--ink-900); }
  .status { font-weight: 700; font-size: var(--fs-body-lg); }
  .status:empty { display: none; }

  /* Borrón sobre tinta: es coral y sobre el coral se perdería */
  .mascot {
    display: grid;
    place-items: center;
    min-height: 64vw;
    background: var(--ink-900);
  }
  .mascot img { grid-area: 1 / 1; width: min(80%, 380px); }
  .note {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    color: var(--lime-400);
    rotate: -5deg;
  }
  [data-show] { display: none; }
  .mascot[data-mood="idle"] [data-show="idle"],
  .mascot[data-mood="ko"] [data-show="ko"],
  .mascot[data-mood="think"] [data-show="think"],
  .mascot[data-mood="yay"] [data-show="yay"] { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    .mascot img[data-show] { animation: boing 500ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  }
  @keyframes boing { from { scale: 0.9; rotate: -4deg; } }

  @media (min-width: 768px) {
    .bar { grid-template-columns: auto 1fr auto; min-height: 96px; }
    .cell, textarea { min-height: 96px; }
    textarea { resize: none; }
  }

  /* Escritorio: campo coral a 8 columnas, Borrón a 4 */
  @media (min-width: 1024px) {
    .contact { grid-template-columns: repeat(12, 1fr); }
    .field { grid-column: 1 / 9; min-height: 80svh; padding: var(--space-8) var(--space-6) var(--space-6); }
    .mascot { grid-column: 9 / -1; min-height: 0; }
  }
</style>
