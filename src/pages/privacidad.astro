---
import BaseLayout from '../layouts/BaseLayout.astro';
import { privacy, site } from '../copy';
---

<BaseLayout title={privacy.title} description={privacy.description}>
  <!-- Tablero: título en violeta · texto legal en una baldosa clara, a medida de lectura -->
  <article class="board legal">
    <header class="tile title">
      <h1>{privacy.title}</h1>
      <p>{privacy.updated}</p>
    </header>
    <div class="tile prose">
      <p>{privacy.body}</p>
      <p>{privacy.contact} <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </article>
</BaseLayout>

<style>
  .legal { padding-top: var(--board-gap); min-height: calc(100svh - 56px - var(--board-gap)); }
  .title {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-4);
    padding-top: var(--space-8);
    background: var(--violet-600);
    color: var(--white);
  }
  h1 { font-size: var(--fs-h1); line-height: 0.95; text-wrap: balance; }

  .prose {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    background: var(--lavender-50);
    color: var(--accent-ink);
    font-size: var(--fs-body-lg);
  }
  .prose p { max-width: 65ch; }
  .prose a { color: var(--violet-600); font-weight: 700; }

  @media (min-width: 1024px) {
    .legal { grid-template-columns: repeat(12, 1fr); }
    .title { grid-column: 1 / 6; padding: var(--space-6); }
    .prose { grid-column: 6 / -1; padding: var(--space-8) var(--space-6); }
  }
</style>
