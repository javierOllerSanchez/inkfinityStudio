---
import { withBase } from '../base';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCopy } from '../copy';
import AsciiReveal from '../components/AsciiReveal.astro';
const { notFound } = getCopy(Astro.currentLocale);
---

<BaseLayout title={notFound.title} description={notFound.text}>
  <!-- Tablero: Borrón KO sobre tinta · el mensaje en coral -->
  <section class="board ko" aria-labelledby="ko-title">
    <div class="tile mascot">
      <AsciiReveal design="tinta" />
      <img src={withBase('/assets/mascot/borron-ko.svg')} alt="Borrón, la mascota, fuera de combate" width="480" height="480" />
    </div>
    <div class="tile message">
      <h1 id="ko-title">{notFound.title}</h1>
      <p>{notFound.text}</p>
      <a class="btn btn--ink" href={withBase('/')}>{notFound.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .ko { padding-top: var(--board-gap); min-height: calc(100svh - 56px - var(--board-gap)); }
  .mascot { display: grid; place-items: center; min-height: 60vw; background: var(--ink-900); }
  .mascot img { width: min(80%, 420px); }

  .message {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-5);
    padding-top: var(--space-8);
    background: var(--coral-500);
    color: var(--accent-ink);
  }
  h1 { font-size: var(--fs-h1); line-height: 0.95; text-wrap: balance; }
  p { font-size: var(--fs-body-lg); max-width: 34ch; }

  @media (min-width: 1024px) {
    .ko { grid-template-columns: repeat(12, 1fr); }
    .mascot { grid-column: 1 / 6; min-height: 0; }
    .message { grid-column: 6 / -1; padding: var(--space-6); }
  }
</style>
